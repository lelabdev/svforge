{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svforge.dev/docs/release-plan.schema.json",
  "title": "SVForge release plan",
  "type": "object",
  "required": ["schemaVersion", "versionPolicy", "commit", "changelog", "compatibility", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "versionPolicy": { "const": "independent" },
    "commit": { "type": "string", "minLength": 1 },
    "changelog": {
      "type": "object",
      "required": ["path", "entries"],
      "properties": {
        "path": { "const": "CHANGELOG.md" },
        "entries": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "description": "Exact compatible version of every package in this distribution, embedded into the published svforge CLI.",
      "type": "object",
      "required": ["schema", "template", "packages"],
      "properties": {
        "schema": { "const": 1 },
        "template": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "svforge" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
          },
          "additionalProperties": false
        },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
        }
      },
      "additionalProperties": false
    },
    "registry": { "type": "string", "format": "uri" },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "directory", "manifestPath", "localDependencies"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "directory": { "type": "string", "pattern": "^packages/[^/]+$" },
          "manifestPath": { "type": "string", "pattern": "^packages/[^/]+/package\\.json$" },
          "localDependencies": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "registry": {
            "type": "object",
            "required": ["published", "latest", "availableVersions"],
            "properties": {
              "published": { "type": "boolean" },
              "latest": { "type": ["string", "null"] },
              "availableVersions": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
