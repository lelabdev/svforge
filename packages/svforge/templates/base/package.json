{
	"name": "sf-fresh",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --tsconfig ./tsconfig.json && node svforge-check.mjs",
		"check:watch": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@inlang/paraglide-js": "^2.24.0",
		"clsx": "^2.1.1",
		"phosphor-svelte": "^3.1.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.0",
		"@tailwindcss/typography": "^0.5.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"globals": "^17.0.0",
		"lefthook": "^2.0.13",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"prettier-plugin-tailwindcss": "^0.7.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.0.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.0.0",
		"vite": "^8.0.7",
		"vitest": "^5.0.0"
	}
}
