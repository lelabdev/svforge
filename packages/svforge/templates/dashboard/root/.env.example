# Database (PostgreSQL) — configure separately from local file preparation.
# bash scripts/setup.sh creates .env and a secret; it never starts services
# or applies a schema. Set DATABASE_URL in .env after creating your database.
DATABASE_URL=
# Example (replace credentials):
# DATABASE_URL="postgres://user:password@127.0.0.1:5432/my_dashboard"
# Managed PostgreSQL: use your provider's URL; review it before any DB command.

# Better Auth
ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=changeme

# Sign-up policy (#318) — enforced SERVER-side, never by the UI:
# - closed (default)     no public sign-up; admins create users from /admin/users
# - invite-only          only pre-approved emails (invited from /admin/users) can register
# - self-service         anyone can register — admins are ONLY ever explicit (role column)
# Unknown values fall back to closed. Change requires a server restart.
SIGNUP_MODE=closed

# First-admin bootstrap command (atomic, fails if an admin already exists):
#   <package manager> run admin:create -- --name "Admin" --email admin@example.com --password '…'
# (or ADMIN_NAME / ADMIN_EMAIL / ADMIN_PASSWORD environment variables)

# Notes:
# - Generate a strong secret: openssl rand -base64 32
# - ORIGIN must match your dev server URL
# - Create the database first if it doesn't exist:
#     createdb sf_dashboard

# Integration TEST database (#312) ──────────────────────────────
# The shipped integration suites NEVER touch the DATABASE_URL above: they
# require a DEDICATED test database exported as TEST_DATABASE_URL, whose
# name must contain a "test" segment — anything else is refused before a
# single row is read, and cleanup only ever removes the rows the suite
# created itself.
#   createdb myapp_test
#   TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/myapp_test"
# TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/myapp_test"
