{
	"name": "svforge",
	"version": "2.1.2",
	"type": "module",
	"description": "Production-ready foundations for SvelteKit projects with Skeleton UI, Tailwind CSS, Better Auth, and Drizzle ORM",
	"author": "Ludo (https://lelab.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lelabdev/svforge.git",
		"directory": "packages/svforge"
	},
	"homepage": "https://github.com/lelabdev/svforge#readme",
	"bugs": "https://github.com/lelabdev/svforge/issues",
	"types": "./dist/index.d.ts",
	"bin": {
		"svforge": "./bin/svforge.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/",
		"bin/",
		"docs/llms-skeleton.txt",
		"docs/llms-svelte.txt",
		"docs/deployment-profiles.md",
		"docs/structural-duplication.md",
		"docs/sveltekit-compatibility.md"
	],
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit",
		"boilerplate",
		"skeleton-ui",
		"tailwindcss",
		"ui-components",
		"starter",
		"template"
	],
	"license": "MIT",
	"peerDependencies": {
		"sv": "^1.1.0"
	},
	"devDependencies": {
		"@svforge/addon-kit": "workspace:*",
		"sv": "^1.1.0",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"prebuild": "bun scripts/prebuild.ts",
		"build": "bun run prebuild && tsdown",
		"prepublishOnly": "bun run build"
	}
}
