{
	"name": "@svforge/tiptap",
	"version": "2.0.2",
	"type": "module",
	"description": "SVForge Tiptap — rich text editor with toolbar and preview",
	"author": "Ludo (https://lelab.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lelabdev/svforge.git",
		"directory": "packages/tiptap"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/"
	],
	"license": "MIT",
	"peerDependencies": {
		"sv": "^1.1.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0"
	},
	"devDependencies": {
		"@svforge/addon-kit": "workspace:*",
		"sv": "^1.1.0",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"prebuild": "bun scripts/prebuild.ts",
		"build": "bun run prebuild && tsdown",
		"prepublishOnly": "bun run build"
