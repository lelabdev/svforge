{
	"name": "@svforge/uploads",
	"version": "2.0.1",
	"type": "module",
	"description": "SVForge Uploads — file uploads to S3/R2",
	"author": "Ludo (https://lelab.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lelabdev/svforge.git",
		"directory": "packages/uploads"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/"
	],
	"license": "MIT",
	"peerDependencies": {
		"sv": "^1.1.0"
	},
	"devDependencies": {
		"@svforge/addon-kit": "workspace:*",
		"sv": "^1.1.0",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"prebuild": "bun scripts/prebuild.ts",
		"build": "bun run prebuild && bunx tsdown",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"sv-add",
		"svforge",
		"uploads",
		"s3",
		"r2",
		"file-upload",
		"presign",
		"svelte",
		"sveltekit"
	],
	"types": "./dist/index.d.ts"
}
