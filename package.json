{
  "name": "svforge-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter svforge build",
    "build:all": "bun run --filter '*' build",
    "lint": "eslint . && eslint --no-ignore 'packages/*/templates/src/**/*.svelte' 'packages/svforge/templates/*/src/**/*.svelte'",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit.mjs",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:user-journey": "bash scripts/test-user-journey.sh",
    "release:plan": "node scripts/release-plan.mjs",
    "graphify:update": "graphify update . --no-cluster && node scripts/normalize-graphify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.1",
    "@types/jsdom": "^30.0.0",
    "@types/ws": "^8.5.14",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "sv": "1.1.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "dependencies": {},
  "overrides": {
    "brace-expansion": "^5.0.12",
    "devalue": "^5.9.3"
  }
}
